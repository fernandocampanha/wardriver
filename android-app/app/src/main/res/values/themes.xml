<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Somente claro, como o site. -->
    <style name="Theme.WardriverSync" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/signal</item>
        <item name="colorOnPrimary">@color/panel</item>
        <item name="colorPrimaryContainer">@color/signal_soft</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/signal_2</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_2</item>
        <item name="colorOutline">@color/rule_strong</item>
        <item name="colorOutlineVariant">@color/rule</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.Wardriver.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Wardriver.Medium</item>
        <item name="actionBarStyle">@style/Widget.Wardriver.ActionBar</item>
        <item name="android:actionBarStyle">@style/Widget.Wardriver.ActionBar</item>
        <item name="materialButtonStyle">@style/Widget.Wardriver.Button</item>
    </style>

    <!-- Barra de titulo: branca, com filete e titulo em tinta (antes saia lilas do Material 3). -->
    <style name="Widget.Wardriver.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@drawable/bg_actionbar</item>
        <item name="android:background">@drawable/bg_actionbar</item>
        <item name="titleTextStyle">@style/Text.Wardriver.Title</item>
        <item name="android:titleTextStyle">@style/Text.Wardriver.Title</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Text.Wardriver.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Shape.Wardriver.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
    <style name="Shape.Wardriver.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Botao padrao: contorno fino; o de destaque usa Widget.Wardriver.Button.Primary. -->
    <style name="Widget.Wardriver.Button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/rule_strong</item>
        <item name="iconGravity">start</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/signal</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">@color/signal_soft</item>
    </style>
    <style name="Widget.Wardriver.Button.Primary" parent="Widget.Material3.Button">
        <item name="iconGravity">start</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/icon_on_primary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Cartao de destaque: mesmo vocabulario do cartao de status (fundo claro, filete, cantos grandes);
         icone grande em cima, nome embaixo. A cor vem de app:backgroundTint / strokeColor / iconTint no layout. -->
    <style name="Widget.Wardriver.Button.Hero" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">96dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">34dp</item>
        <item name="iconPadding">6dp</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Text.Wardriver.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/muted</item>
    </style>
</resources>
