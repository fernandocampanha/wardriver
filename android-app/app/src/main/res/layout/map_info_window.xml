<?xml version="1.0" encoding="utf-8"?>
<!-- Balao de informacao de uma rede no mapa, aberto por NetworkInfoWindow (MapActivity).
     Independente de qualquer Marker: o SimpleFastPointOverlay nao tem balao proprio
     (ver BACKLOG.md item 16), entao este layout e aberto manualmente na posicao da rede tocada. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/bubble_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxEms="18"
            android:textStyle="bold"
            android:textSize="14sp"
            tools:text="Nome da rede" />

        <TextView
            android:id="@+id/bubble_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxEms="18"
            android:textSize="12sp"
            tools:text="BSSID: AA:BB:CC:DD:EE:FF" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
